APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret
APP_CORS_ORIGINS=http://localhost:5173

# false uses the real MySQL query gateway. rules works without an external LLM.
MOCK_MODE=false
TEXT_TO_SQL_MODE=rules

BUSINESS_DB_HOST=127.0.0.1
BUSINESS_DB_PORT=3306
BUSINESS_DB_NAME=data_agent_retail
BUSINESS_DB_USER=data_agent_ro
BUSINESS_DB_PASSWORD=replace_with_readonly_password

# Required only when TEXT_TO_SQL_MODE=llm
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=15
QUERY_APPROVED_TIMEOUT_SECONDS=60
QUERY_RESULT_MAX_BYTES=5242880
QUERY_L1_SCAN_ROWS=100000
QUERY_L2_SCAN_ROWS=1000000
ALLOWED_TABLES=regions,categories,customers,products,orders,order_items
